# AI 쇼호스트 라이브 — 환경 변수 (이 파일을 복사한 .env 에 값을 넣는다. .env 는 Git에 올리지 않는다)
# 처음 아무 스크립트나 실행하면 ailive_config.py 가 이 파일로 .env 를 자동으로 만든다.

# ── 필수: 유료 생성 단계에서만 사용 ──
# OpenAI — 새 호스트 캐릭터 생성(gpt-image-2.5-flare). R3 호스트를 재사용하면 필요 없음
OPENAI_API_KEY=
# 사내 프록시를 쓰면 주소, 아니면 비워 둠
OPENAI_BASE_URL=

# MiniMax Open Platform (https://platform.minimax.io) — 목소리(Voice Design·T2A speech-2.8-hd) + 호스트 영상(MiniMax-H3)
MINIMAX_API_KEY=

# ── 선택 ──
# ffmpeg/ffprobe 위치 (PATH에 있으면 비워 둠)
FFMPEG_PATH=
FFPROBE_PATH=
# 라벨용 한글 글꼴 (비우면 맑은 고딕 → 저장소 Pretendard 순)
KO_FONT_PATH=
KO_FONT_BOLD_PATH=
# 2차 활용 콘텐츠 영상 폴더 (probe_secondary.py 용, 팀 OneDrive 'AX팀/20. AI쇼핑라이브/2차 활용 콘텐츠')
SECONDARY_CONTENT_DIR=
